{
  "session-baseline": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python scripts/hooks/session_start.py",
        "timeout": 10
      }
    ]
  },
  "command-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "docs-sync-check": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/post_edit_check.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
